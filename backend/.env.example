# Backend Server Configuration
PORT=5001
NODE_ENV=production

# MongoDB Production Connection String
# Replace with your MongoDB Atlas or production MongoDB connection URI:
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/roots_management?retryWrites=true&w=majority

# Allowed Frontend Origins for CORS (comma-separated for multiple domains)
CLIENT_URL=https://your-frontend-domain.vercel.app,http://localhost:5173
