# ====================================================================
# Roots Media Employee & Task Management System - Environment Template
# ====================================================================

# --- Vercel All-in-One Full-Stack Deployment ---
# In Vercel Project Settings > Environment Variables, add:
# 1. MONGODB_URI: Your MongoDB Atlas connection string
# 2. NODE_ENV: production
# (Optional) CLIENT_URL: Not needed for all-in-one since frontend and API share the domain.

# --- Backend Configuration (Local or Separate Server) ---
PORT=5001
NODE_ENV=production

# MongoDB Connection String (Atlas or Hosted MongoDB)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/roots_management?retryWrites=true&w=majority

# CORS Configuration: Frontend URLs allowed to connect (comma-separated, *.vercel.app is allowed automatically)
CLIENT_URL=https://your-frontend-app.vercel.app,http://localhost:5173

# --- Frontend Configuration (Vite) ---
# For Vercel All-in-One: Leave empty or omit (defaults to relative /api)
# For Separate Backend Server (Render/Railway):
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
